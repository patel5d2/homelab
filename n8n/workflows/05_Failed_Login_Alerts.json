{
  "name": "Failed SSH Login Alerts (journalctl -> Discord)",
  "nodes": [
    {
      "name": "Every 5 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        250,
        400
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 * * * *"
            }
          ]
        }
      }
    },
    {
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        490,
        400
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e1721687-e60c-48cd-aca9-a16704c18625",
              "name": "hostLabel",
              "value": "homelab-server",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Fetch failed logins",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        730,
        400
      ],
      "parameters": {
        "authentication": "password",
        "command": "journalctl -u ssh -u sshd --since '5 min ago' --no-pager -o short-iso 2>/dev/null | grep -Ei 'failed password|invalid user|authentication failure' || true"
      }
    },
    {
      "name": "Parse Failed Attempts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        970,
        400
      ],
      "parameters": {
        "jsCode": "const out = $input.first().json.stdout || '';\nconst lines = out.split('\\n').filter(Boolean);\nconst ips = {};\nfor (const l of lines) {\n  const m = l.match(/from (\\d{1,3}(?:\\.\\d{1,3}){3}|[0-9a-f:]+:[0-9a-f:]*)/i);\n  if (m) ips[m[1]] = (ips[m[1]] || 0) + 1;\n}\nconst topIps = Object.entries(ips).sort((a, b) => b[1] - a[1]).slice(0, 5)\n  .map(([ip, n]) => `${ip} (${n})`);\nreturn [{ json: { count: lines.length, topIps, sample: lines.slice(-5).join('\\n').slice(0, 1200) } }];"
      }
    },
    {
      "name": "Any failures?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1210,
        400
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "18aa3465-7a27-488d-bafd-3527f3f9a92c",
              "leftValue": "={{ $json.count }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 0
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Notify Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1450,
        400
      ],
      "parameters": {
        "authentication": "webhook",
        "content": "=🔐 **{{ $json.count }}** failed SSH login(s) on `{{ $('Config').first().json.hostLabel }}` in the last 5 min\nTop IPs: {{ $json.topIps.join(', ') || 'n/a' }}\n```\n{{ $json.sample }}\n```",
        "options": {}
      }
    },
    {
      "name": "Note 3450",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        200,
        20
      ],
      "parameters": {
        "content": "## Setup\n1. **Fetch failed logins**: SSH Private Key credential (user must be able to read the journal: `adm` or `systemd-journal` group).\n2. **Config**: `hostLabel` for the alert.\n3. **Notify Discord**: Discord Webhook credential.\n\nUses a 5-minute journal window matching the schedule, so the same lines aren't re-alerted every run.",
        "width": 1440,
        "height": 340,
        "color": 4
      }
    }
  ],
  "connections": {
    "Every 5 min": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Fetch failed logins",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch failed logins": {
      "main": [
        [
          {
            "node": "Parse Failed Attempts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Failed Attempts": {
      "main": [
        [
          {
            "node": "Any failures?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any failures?": {
      "main": [
        [
          {
            "node": "Notify Discord",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
