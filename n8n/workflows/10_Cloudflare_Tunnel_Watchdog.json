{
  "name": "Cloudflare Tunnel Watchdog (check -> SSH restart -> Discord)",
  "nodes": [
    {
      "name": "Every 5 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        250,
        400
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 * * * *"
            }
          ]
        }
      }
    },
    {
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        490,
        400
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ed511903-68a8-4867-9adb-b3fc53419f0c",
              "name": "tunnelUrl",
              "value": "https://service.example.com",
              "type": "string"
            },
            {
              "id": "ee9cc562-73e8-4f72-a86f-f83faf3d56b0",
              "name": "hostLabel",
              "value": "tunnel-host",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Check Tunnel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        730,
        400
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.tunnelUrl }}",
        "options": {
          "timeout": 10000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "name": "Tunnel down?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        970,
        400
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "ebd05ab4-0cd3-4187-b1ee-b822a3213cf0",
              "leftValue": "={{ !$json.statusCode || $json.statusCode >= 500 }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Restart cloudflared",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        1210,
        400
      ],
      "parameters": {
        "authentication": "password",
        "command": "sudo systemctl restart cloudflared && sleep 15 && systemctl is-active cloudflared"
      },
      "onError": "continueRegularOutput"
    },
    {
      "name": "Notify Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1450,
        400
      ],
      "parameters": {
        "authentication": "webhook",
        "content": "=⚠️ Cloudflare tunnel `{{ $('Config').first().json.tunnelUrl }}` was down (HTTP {{ $('Check Tunnel').first().json.statusCode || 'no response' }}). Restarted cloudflared on `{{ $('Config').first().json.hostLabel }}` → **{{ ($json.stdout || '').trim() || 'restart failed: ' + ($json.stderr || $json.error?.message || $json.error) }}**",
        "options": {}
      }
    },
    {
      "name": "Note 9af0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        200,
        20
      ],
      "parameters": {
        "content": "## Setup\n1. **Config**: `tunnelUrl` (a hostname served through the tunnel), `hostLabel`.\n2. **Restart cloudflared**: SSH Private Key credential; user needs passwordless sudo for `systemctl restart cloudflared` (or change to `docker restart cloudflared`).\n3. **Notify Discord**: Discord Webhook credential.\n\nDown = no response or HTTP 5xx (Cloudflare returns 502/530 when the tunnel is gone). 3xx/4xx (e.g. Cloudflare Access) counts as up.",
        "width": 1440,
        "height": 340,
        "color": 4
      }
    }
  ],
  "connections": {
    "Every 5 min": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Check Tunnel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Tunnel": {
      "main": [
        [
          {
            "node": "Tunnel down?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tunnel down?": {
      "main": [
        [
          {
            "node": "Restart cloudflared",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Restart cloudflared": {
      "main": [
        [
          {
            "node": "Notify Discord",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
